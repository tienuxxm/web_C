      totalSpent: 1876.30,
      lastOrder: '2024-01-10',
      joinDate: '2023-07-18',
      avatar: 'https://images.pexels.com/photos/1043471/pexels-photo-1043471.jpeg?auto=compress&cs=tinysrgb&w=100&h=100&dpr=1'
    }
