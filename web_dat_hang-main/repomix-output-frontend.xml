@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    /* --- LIGHT MODE --- */
    /* Màu nền trang: Xám xanh rất nhạt (Sáng, sang trọng, tôn màu trắng của block) */
    --page-bg: 241 245 249; /* Tương đương Slate-100 */
  }
  
  .dark {
    /* --- DARK MODE --- */
    /* Màu nền trang: Đen sâu (Deep Navy/Black) để làm nổi hiệu ứng kính */
    --page-bg: 2 6 23; /* Tương đương Slate-950 */
  }

  body {
    /* Áp dụng biến màu vừa định nghĩa */
    @apply bg-[rgb(var(--page-bg))] text-slate-900 dark:text-slate-100 transition-colors duration-300;
  }
}

@layer components {
  .glass-panel {
    @apply backdrop-blur-xl border transition-all duration-300;
  }
  
  /* Light Mode Specifics */
  .glass-panel-light {
    @apply bg-blue/80 border-white/60 shadow-glass-light;
  }

  /* Dark Mode Specifics */
  .dark .glass-panel-dark {
    @apply bg-bitex-dark/70 border-white/10 shadow-glass-dark;
