            )}
          </div>

        </form>
      </div>
      {inspectItemId && (
        <DistributionModal
          itemId={inspectItemId}
          onClose={() => setInspectItemId(null)}
        />
      )}
    </div>
    ,
    document.body
  );
};

export default OrderModal;
